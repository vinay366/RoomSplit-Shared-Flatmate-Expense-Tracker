rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.id is string
        && data.displayName is string
        && data.email is string
        && (!('activeRoomId' in data) || data.activeRoomId is string || data.activeRoomId == null)
        && (!('avatarColorHex' in data) || data.avatarColorHex is string)
        && (!('upiId' in data) || data.upiId is string || data.upiId == null)
        && (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidRoom(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.inviteCode is string
        && data.inviteCode.size() >= 4
        && data.inviteCode.size() <= 10
        && data.createdBy is string
        && (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidMember(data) {
      return data.userId is string
        && data.displayName is string
        && (!('avatarColorHex' in data) || data.avatarColorHex is string)
        && (!('upiId' in data) || data.upiId is string || data.upiId == null)
        && (!('joinedAt' in data) || data.joinedAt is number);
    }

    function isValidEntry(data) {
      return data.amount is number
        && data.amount > 0
        && data.category is string
        && data.itemName is string
        && data.itemName.size() > 0
        && data.itemName.size() <= 80
        && data.paidByMemberId is string
        && data.date is string
        && (!('note' in data) || data.note is string || data.note == null)
        && (!('paidByMemberName' in data) || data.paidByMemberName is string)
        && (!('paidByMemberAvatarColorHex' in data) || data.paidByMemberAvatarColorHex is string)
        && (!('createdAt' in data) || data.createdAt is number)
        && (!('isSettlement' in data) || data.isSettlement is bool)
        && (!('settlementReceiverId' in data) || data.settlementReceiverId is string || data.settlementReceiverId == null);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidRoom(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && isValidRoom(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid);

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isValidMember(request.resource.data);
        allow delete: if isAuthenticated();
      }

      match /entries/{entryId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidEntry(request.resource.data);
        allow update: if isAuthenticated() && isValidEntry(request.resource.data);
        allow delete: if isAuthenticated();
      }
    }
  }
}
