{
  "entities": {
    "users": {
      "path": "users/{userId}",
      "fields": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "activeRoomId": { "type": "string", "optional": true },
        "avatarColorHex": { "type": "string" },
        "upiId": { "type": "string", "optional": true },
        "createdAt": { "type": "number" }
      }
    },
    "rooms": {
      "path": "rooms/{roomId}",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "inviteCode": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "subcollections": {
        "members": {
          "path": "rooms/{roomId}/members/{memberId}",
          "fields": {
            "userId": { "type": "string" },
            "displayName": { "type": "string" },
            "avatarColorHex": { "type": "string" },
            "upiId": { "type": "string", "optional": true },
            "joinedAt": { "type": "number" }
          }
        },
        "entries": {
          "path": "rooms/{roomId}/entries/{entryId}",
          "fields": {
            "id": { "type": "string" },
            "amount": { "type": "number" },
            "category": { "type": "string" },
            "itemName": { "type": "string" },
            "paidByMemberId": { "type": "string" },
            "paidByMemberName": { "type": "string" },
            "paidByMemberAvatarColorHex": { "type": "string" },
            "date": { "type": "string" },
            "note": { "type": "string", "optional": true },
            "isSettlement": { "type": "boolean", "optional": true },
            "settlementReceiverId": { "type": "string", "optional": true },
            "createdAt": { "type": "number" }
          }
        }
      }
    }
  }
}
